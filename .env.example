# Database Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_actual_password_here
MYSQL_DATABASE=employee_db
MYSQL_PORT=3306

# For production environments, never commit actual passwords to version control
# Copy this file to .env and update with your actual values

# Google Gemini AI Configuration (Optional - Dashboard falls back to Smart Heuristic Engine if not set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=2048